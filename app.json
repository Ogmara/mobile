{
  "expo": {
    "name": "Ogmara",
    "slug": "ogmara",
    "version": "0.39.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "ogmara",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E1621"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.ogmara.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Ogmara uses Face ID to unlock the app and protect your wallet."
      }
    },
    "android": {
      "package": "org.ogmara.app",
      "versionCode": 52,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E1621"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Ogmara saves images you download from chats to your photo library.",
          "granularPermissions": [
            "photo"
          ]
        }
      ]
    ]
  }
}
