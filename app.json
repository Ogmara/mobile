{
  "expo": {
    "name": "Ogmara",
    "slug": "ogmara",
    "version": "0.59.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "ogmara",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.ogmara.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Ogmara uses Face ID to unlock the app and protect your wallet."
      }
    },
    "android": {
      "package": "org.ogmara.app",
      "versionCode": 81,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E1621"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0E1621",
          "resizeMode": "contain"
        }
      ],
      "expo-localization",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-notifications",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Ogmara saves images you download from chats to your photo library.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      "expo-font"
    ]
  }
}
